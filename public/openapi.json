{
  "openapi": "3.1.0",
  "info": {
    "title": "Market Arena API",
    "version": "6.0.0",
    "description": "One ticker, sixty seconds, zero initial capital. No opening price; lastPrice is null until first execution. Atlas attempts one trade every 10 seconds. Final P&L = cash + position \u00d7 closing midpoint, with last-executed-price fallback when either book side is missing. valuation provides current or frozen price/source/bid/ask; settlementPrice is final-only. Prices are dollars, midpoint half-ticks are retained. Realized/unrealized P&L are separate. Host and agent tokens are returned only on creation/registration. Atlas independently selects best-first or worst-first execution with 50% probability each, with FIFO at equal prices and a 1\u20135 contract total cap per attempt. Only Atlas may reverse price priority. atlas.ticks records modes, quantities, available best/worst prices and executions. Competing agents always match at best prices. Eight default agents use five Sail models; II agents are independent instances. Website model agents retain their complete per-game conversation, replay it for each decision, and receive actual tool results. Host exports include trajectories; agent tokens only expose their own transcript."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "arenaToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Arena-Token"
      }
    }
  },
  "paths": {
    "/api/arena/rules": {
      "get": {
        "summary": "Read market rules",
        "security": [],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      }
    },
    "/api/arena/games": {
      "post": {
        "summary": "Create a 60-second lobby",
        "security": [],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seed": {
                    "type": "integer",
                    "default": 42
                  },
                  "agents": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "provider": {
                          "type": "string",
                          "enum": [
                            "baseline",
                            "modal",
                            "sail",
                            "fireworks",
                            "external"
                          ]
                        },
                        "model": {
                          "type": "string"
                        },
                        "strategy": {
                          "type": "string",
                          "enum": [
                            "maker",
                            "mean_reversion",
                            "momentum"
                          ]
                        },
                        "intervalMs": {
                          "type": "integer",
                          "minimum": 500,
                          "maximum": 10000
                        },
                        "preset": {
                          "type": "string",
                          "description": "Optional arena-provided slot ID from GET /api/arena/defaults. Model/provider/interval must match its metadata; each slot can appear once."
                        }
                      }
                    }
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/arena/games/{id}": {
      "get": {
        "summary": "Read game state",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/agents": {
      "post": {
        "summary": "Register an external agent (host token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/start": {
      "post": {
        "summary": "Start the server clock (host token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
