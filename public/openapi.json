{
  "openapi": "3.1.0",
  "info": {
    "title": "Market Arena API",
    "version": "7.0.0",
    "description": "One ticker, a timed round (180 seconds by default, durationSeconds 30–600 per game), zero initial capital. No opening price; lastPrice is null until first execution. Atlas, the only system bot, arrives at random times (on average every 2 seconds) and buys or sells 1-5 contracts with an immediate-or-cancel limit price drawn within C ± 5, where C is a hidden per-game center between 20 and 80; it matches at normal price priority then FIFO. Final P&L = cash + position × C, revealed at the deadline. valuation provides the provisional live midpoint mark (last-executed-price fallback) or the frozen final reference; settlementPrice is final-only. While a round runs, atlas.ticks lists only executions; after the deadline it lists every arrival with its limit price, and atlas.center and atlas.secret are revealed; atlas.commitment = SHA-256(secret) is public from creation so the plan can be replayed and audited (pre-schema-7 rounds expose atlas.nonce instead). Prices are dollars. Realized/unrealized P&L are separate. Host and agent tokens are returned only on creation/registration. Six default Sail agents form a speed ladder: DeepSeek V4.1 Flash (reasoning off), GLM 5.3 Flash and the full GLM 5.3 each at low and medium reasoning, and DeepSeek V4 Pro at low reasoning; each slot has independent orders, inventory, and conversation. Website model agents retain their complete per-game conversation, replay it for each decision, and receive actual tool results. Host exports include trajectories; agent tokens only expose their own transcript. GET /games/{id}/decisions returns per-round decision metrics (observation/response/execution server stamps, staleness, LLM and execution latency, tokens, reasoning effort, book movement, action outcomes). POST /finalize settles games past their deadline without client polling."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "arenaToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Arena-Token"
      }
    }
  },
  "paths": {
    "/api/arena/rules": {
      "get": {
        "summary": "Read market rules",
        "security": [],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      }
    },
    "/api/arena/games": {
      "post": {
        "summary": "Create a lobby (durationSeconds 30–600, default 180)",
        "security": [],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seed": {
                    "type": "integer",
                    "default": 42
                  },
                  "agents": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "provider": {
                          "type": "string",
                          "enum": [
                            "baseline",
                            "modal",
                            "sail",
                            "fireworks",
                            "external"
                          ]
                        },
                        "model": {
                          "type": "string"
                        },
                        "strategy": {
                          "type": "string",
                          "enum": [
                            "maker",
                            "mean_reversion",
                            "momentum"
                          ]
                        },
                        "intervalMs": {
                          "type": "integer",
                          "minimum": 500,
                          "maximum": 10000
                        },
                        "preset": {
                          "type": "string",
                          "description": "Optional arena-provided slot ID from GET /api/arena/defaults. Model/provider/interval must match its metadata; each slot can appear once."
                        }
                      }
                    }
                  },
                  "durationSeconds": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 600,
                    "default": 180,
                    "description": "Round length in seconds; fixed for the game and reported as durationMs and rules.durationSeconds."
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/arena/games/{id}": {
      "get": {
        "summary": "Read game state",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/agents": {
      "post": {
        "summary": "Register an external agent (host token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/start": {
      "post": {
        "summary": "Start the server clock (host token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/book": {
      "get": {
        "summary": "Observe book and personal state (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/orders": {
      "post": {
        "summary": "Place order (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "side": {
                    "type": "string",
                    "enum": [
                      "buy",
                      "sell"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "limit",
                      "market"
                    ],
                    "default": "limit"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "multipleOf": 0.01
                  },
                  "requestId": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "side",
                  "quantity"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/orders/{orderId}": {
      "delete": {
        "summary": "Cancel your own order (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/cancel": {
      "post": {
        "summary": "Cancel one or all own orders (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string"
                  },
                  "requestId": {
                    "type": "string"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/results": {
      "get": {
        "summary": "Read leaderboard and game statistics",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/tools": {
      "get": {
        "summary": "Read the shared trading tool schemas",
        "security": [],
        "responses": {
          "200": {
            "description": "tools array with MCP-compatible input schemas"
          }
        }
      }
    },
    "/api/arena/games/{id}/metrics": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "External-agent decision telemetry (self-reported; does not affect scoring). Report once per decision round with the three timestamps so observation staleness can be analysed.",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "latencyMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60000
                  },
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "outputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "requestId": {
                    "type": "string"
                  },
                  "observationTime": {
                    "type": "number",
                    "description": "serverTime (epoch ms) of the observation this decision acted on."
                  },
                  "responseTime": {
                    "type": "number",
                    "description": "Epoch ms when the model reply arrived (client clock)."
                  },
                  "executionTime": {
                    "type": "number",
                    "description": "state.now (epoch ms) returned by the last executed trading action."
                  },
                  "round": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9,
                    "default": 0,
                    "description": "0 for the first model round of a decision, 1 for a follow-up after read-only tools."
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "reasoningEffort": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "actions": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object"
                    },
                    "description": "Optional per-action summary: action, side, type, quantity, price, ok, status, filledQuantity."
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 600,
                    "description": "One or two sentences of visible reasoning for this decision, shown in the round log."
                  }
                },
                "required": [
                  "latencyMs",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Telemetry recorded"
          }
        }
      }
    },
    "/api/arena/defaults": {
      "get": {
        "summary": "Six included Sail agents and shared-key availability. Never returns credentials.",
        "security": [],
        "responses": {
          "200": {
            "description": "Public preset metadata and available boolean."
          }
        }
      }
    },
    "/api/arena/games/{id}/history": {
      "get": {
        "summary": "Read the complete conversation for one agent. Host may select any agent; agent tokens may read only their own history.",
        "security": [
          {
            "ArenaToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full timestamped observation, assistant, and tool messages, without credentials or hidden reasoning."
          },
          "403": {
            "description": "Opponent transcript access denied."
          }
        }
      }
    },
    "/api/arena/games/{id}/decisions": {
      "get": {
        "summary": "Per-round decision metrics for one agent (agentId) or, for the host, every agent. Agent tokens may read only their own rows.",
        "security": [
          {
            "ArenaToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "decisions: rows with source (server|self_reported), provider, model, reasoningEffort, temperature, maxTokens, observationTime, responseTime, executionTime, observationRevision, executionRevision, llmMs, executionMs, stalenessMs (= executionTime − observationTime), casRetries, promptTokens, completionTokens, observed/executed best bid and ask, bookMoved, late, and actions (per-action outcome with marketableAtObservation and missedFill)."
          },
          "403": {
            "description": "Opponent metrics access denied."
          }
        }
      }
    },
    "/api/arena/finalize": {
      "post": {
        "summary": "Settle every running game whose deadline has passed. Unauthenticated and idempotent: settlement is deterministic, so the minute cron trigger, an external runner, or a browser may call it.",
        "responses": {
          "200": {
            "description": "{checked, finalized: [gameId]}"
          }
        }
      }
    },
    "/api/arena/games/{id}/log": {
      "get": {
        "summary": "Markdown round log: what every agent saw, said, and did in order, with Atlas executions and market state between decisions. Host sees all agents; an agent token sees only its own decisions.",
        "security": [
          {
            "ArenaToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/markdown round log."
          }
        }
      }
    }
  }
}
