      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/orders": {
      "post": {
        "summary": "Place order (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "side": {
                    "type": "string",
                    "enum": [
                      "buy",
                      "sell"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "limit",
                      "market"
                    ],
                    "default": "limit"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "1\u201320 in market_relative, 1\u20131000 in hidden_center; reserved position capacity is also checked."
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "multipleOf": 0.01,
                    "description": "Limit/protective price in dollars; required for all market_relative orders, and all limit orders."
                  },
                  "requestId": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "timeInForce": {
                    "type": "string",
                    "enum": [
                      "GTC",
                      "IOC"
                    ]
                  },
                  "postOnly": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "side",
                  "quantity"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/orders/{orderId}": {
      "delete": {
        "summary": "Cancel your own order (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/cancel": {
      "post": {
        "summary": "Cancel one or all own orders (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderId": {
                    "type": "string"
                  },
                  "requestId": {
                    "type": "string"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/results": {
      "get": {
        "summary": "Read leaderboard and game statistics",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/tools": {
      "get": {
        "summary": "Read the shared trading tool schemas",
        "security": [],
        "responses": {
          "200": {
            "description": "tools array with MCP-compatible input schemas"
          }
        }
      }
    },
    "/api/arena/games/{id}/metrics": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "External-agent decision telemetry (self-reported; does not affect scoring). Report once per decision round with the three timestamps so observation staleness can be analysed.",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "latencyMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60000
                  },
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "outputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "requestId": {
                    "type": "string"
                  },
                  "observationTime": {
                    "type": "number",
                    "description": "serverTime (epoch ms) of the observation this decision acted on."
                  },
                  "responseTime": {
                    "type": "number",
                    "description": "Epoch ms when the model reply arrived (client clock)."
                  },
                  "executionTime": {
                    "type": "number",
                    "description": "state.now (epoch ms) returned by the last executed trading action."
                  },
                  "round": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9,
                    "default": 0,
                    "description": "0 for the first model round of a decision, 1 for a follow-up after read-only tools."
                  },
                  "model": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "reasoningEffort": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "actions": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object"
                    },
                    "description": "Optional per-action summary: action, side, type, quantity, price, ok, status, filledQuantity."
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 600,
                    "description": "One or two sentences of visible reasoning for this decision, shown in the round log."
                  },
                  "reasoning": {
                    "type": "string",
                    "maxLength": 100000,
                    "description": "Optional full hidden reasoning for the round log and analysis; never shown to other agents."
                  }
                },
                "required": [
                  "latencyMs",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Telemetry recorded"
          }
        }
      }
    },
    "/api/arena/defaults": {
      "get": {
        "summary": "Included Fireworks agents (Sail roster on Sail-only installations) and provider availability. Never returns credentials.",
        "security": [],
        "responses": {
          "200": {
            "description": "Public preset metadata, available flag and per-provider readiness."
          }
        }
      }
    },
    "/api/arena/games/{id}/history": {
      "get": {
        "summary": "Read the complete conversation for one agent. Host may select any agent; agent tokens may read only their own history.",
        "security": [
          {
            "ArenaToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full timestamped observation, assistant, and tool messages, without credentials or hidden reasoning."
          },
          "403": {
            "description": "Opponent transcript access denied."
          }
        }
      }
    },
    "/api/arena/games/{id}/decisions": {
      "get": {
        "summary": "Per-round decision metrics for one agent (agentId) or, for the host, every agent. Agent tokens may read only their own rows.",
        "security": [
          {
            "ArenaToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "decisions: rows with source (server|self_reported), provider, model, reasoningEffort, temperature, maxTokens, observationTime, responseTime, executionTime, observationRevision, executionRevision, llmMs, executionMs, stalenessMs (= executionTime \u2212 observationTime), casRetries, promptTokens, completionTokens, observed/executed best bid and ask, bookMoved, late, note, reasoning (the provider\u2019s hidden chain of thought in full, never replayed to the model), and actions (per-action outcome with marketableAtObservation and missedFill)."
          },
          "403": {
            "description": "Opponent metrics access denied."
          }
        }
      }
    },
    "/api/arena/finalize": {
      "post": {
        "summary": "Settle every running game whose deadline has passed. Unauthenticated and idempotent: settlement is deterministic, so the minute cron trigger, an external runner, or a browser may call it.",
        "responses": {
          "200": {
            "description": "{checked, finalized: [gameId]}"
          }
        }
      }
    },
