            "ArenaToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/markdown round log."
          }
        }
      }
    },
    "/api/arena/modes": {
      "get": {
        "summary": "List available Atlas modes and associated defaults",
        "security": [],
        "responses": {
          "200": {
            "description": "defaultBotMode and modes"
          }
        }
      }
    },
