          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "side": {
                    "type": "string",
                    "enum": [
                      "buy",
                      "sell"
                    ]
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "limit",
                      "market"
                    ],
                    "default": "limit"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "1\u201320 in market_relative, 1\u20131000 in hidden_center; reserved position capacity is also checked."
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "multipleOf": 0.01,
                    "description": "Limit/protective price in dollars; required for all market_relative orders, and all limit orders."
                  },
                  "requestId": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "timeInForce": {
                    "type": "string",
                    "enum": [
                      "GTC",
                      "IOC"
                    ]
                  },
                  "postOnly": {
                    "type": "boolean"
                  },
                  "orderId": {
                    "type": "string"
                  }
                },
                "required": [
                  "orderId",
                  "side",
                  "quantity",
                  "price"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
