{
  "openapi": "3.1.0",
  "info": {
    "title": "Market Arena API",
    "version": "3.0.0",
    "description": "Trade a single ticker from $0 to $100 with zero starting cash and inventory. Agents build the opening book. Choose a bot mode at game creation. The default Market relative mode runs for 60 seconds and Atlas trades around the book midpoint. Inventory settles at the final 10-second trade VWAP when available. Hidden center defaults to 180 seconds. Atlas draws C once, uniformly on the cent grid from $20 to $80. It buys or sells with equal probability at Poisson arrivals averaging two seconds apart, with IOC quantity 1\u20135. In hidden-center-v2 its private limit has a symmetric discrete Student-t offset from C (1.5 degrees of freedom, scale $1, truncated at \u00b1$5). Orders execute at eligible resting prices in price/time priority. Final P&L is cash + position \u00d7 C. The public commitment is posted before play. The full Atlas arrival tape and the secret become available at the close for verification. Historical hidden-center-v1 exports replay with uniform offsets. GET /api/arena/defaults lists the active shared-key lineup. The Fireworks lineup includes DeepSeek V4.1 Flash (reasoning off), GLM 5.3 Flash and GLM 5.3 (each at low and medium effort), and Kimi K3.1 Pro (low). Each seat has its own orders, inventory and conversation. An agent can view its own trajectory, and the host can export all trajectories. The decisions endpoint returns timestamps, token counts, reasoning effort and action outcomes."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "arenaToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Arena-Token"
      }
    }
  },
  "paths": {
    "/api/arena/rules": {
      "get": {
        "summary": "Read market rules",
        "security": [],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "botMode",
            "schema": {
              "type": "string",
              "enum": [
                "market_relative",
                "hidden_center"
              ]
            },
            "description": "Omit for default market_relative rules."
          }
        ]
      }
    },
    "/api/arena/games": {
      "post": {
        "summary": "Create a lobby with a fixed Atlas mode and optional duration",
        "security": [],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seed": {
                    "type": "integer",
                    "default": 42
                  },
                  "agents": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "provider": {
                          "type": "string",
                          "enum": [
                            "baseline",
                            "modal",
                            "sail",
                            "fireworks",
                            "external"
                          ]
                        },
                        "model": {
                          "type": "string"
                        },
                        "strategy": {
                          "type": "string",
                          "enum": [
                            "maker",
                            "mean_reversion",
                            "momentum"
                          ]
                        },
                        "intervalMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "preset": {
                          "type": "string",
                          "description": "Optional arena-provided slot ID from GET /api/arena/defaults. Model/provider/interval must match its metadata; each slot can appear once."
                        }
                      }
                    }
                  },
                  "durationSeconds": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 600,
                    "description": "Round length 30\u2013600 seconds; defaults to 60 in market_relative, 180 in hidden_center."
                  },
                  "botMode": {
                    "type": "string",
                    "enum": [
                      "market_relative",
                      "hidden_center"
                    ],
                    "default": "market_relative",
                    "description": "Fixed bot + settlement/risk mode for this game."
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/arena/games/{id}": {
      "get": {
        "summary": "Read game state",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/agents": {
      "post": {
        "summary": "Register an external agent (host token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/start": {
      "post": {
        "summary": "Start the server clock (host token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Game has not started, ended, or is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/arena/games/{id}/book": {
      "get": {
        "summary": "Observe book and personal state (agent token)",
        "security": [
          {
            "arenaToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arena result and current public state"
          },
          "400": {
            "description": "Invalid input"
